{
  "uid": "meshiq-collectd-host-health",
  "title": "COLLECTD — Host Health",
  "description": "Time-series system metrics (CPU, memory, load, disk, network, swap) collected via collectd and served by the meshIQ Platform datasource.",
  "tags": [
    "showcase",
    "meshiq",
    "collectd"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "schemaVersion": 39,
  "templating": {
    "list": [
      {
        "name": "host",
        "label": "Host",
        "type": "query",
        "datasource": {
          "type": "meshiq-platform-datasource",
          "uid": "meshiq-platform"
        },
        "query": {
          "type": "query",
          "jkql": "Get Number Of COLLECTD.CPU Group By SourceComps('NETADDR')",
          "refId": "variable-host"
        },
        "multi": true,
        "includeAll": true,
        "refresh": 1,
        "sort": 0,
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ],
          "selected": true
        },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "CPU",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 1,
      "type": "timeseries",
      "title": "CPU Usage by Core (User)",
      "datasource": {
        "type": "meshiq-platform-datasource",
        "uid": "meshiq-platform"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "format": "timeseries",
          "jkql": "Get COLLECTD.CPU Field MetricTime, Name, cpu.user.value Where SourceComps('NETADDR') In ($host) And cpu.user.value Exists Sort By MetricTime",
          "datasource": {
            "type": "meshiq-platform-datasource",
            "uid": "meshiq-platform"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "CPU Usage by Core (System + Wait)",
      "datasource": {
        "type": "meshiq-platform-datasource",
        "uid": "meshiq-platform"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "format": "timeseries",
          "jkql": "Get COLLECTD.CPU Field MetricTime, Name, cpu.system.value Where SourceComps('NETADDR') In ($host) And cpu.system.value Exists Sort By MetricTime",
          "datasource": {
            "type": "meshiq-platform-datasource",
            "uid": "meshiq-platform"
          }
        },
        {
          "refId": "B",
          "format": "timeseries",
          "jkql": "Get COLLECTD.CPU Field MetricTime, Name, cpu.wait.value Where SourceComps('NETADDR') In ($host) And cpu.wait.value Exists Sort By MetricTime",
          "datasource": {
            "type": "meshiq-platform-datasource",
            "uid": "meshiq-platform"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "type": "row",
      "title": "Load Average",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "panels": []
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "System Load Average",
      "datasource": {
        "type": "meshiq-platform-datasource",
        "uid": "meshiq-platform"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
