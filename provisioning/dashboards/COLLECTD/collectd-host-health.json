    {
      "id": 8,
      "type": "table",
      "title": "Filesystem Usage",
      "datasource": {
        "type": "meshiq-platform-datasource",
        "uid": "meshiq-platform"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 36
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "jkql": "Get COLLECTD.DF Field Name As 'Mount', df_complex.used.value As 'Used', df_complex.free.value As 'Free', df_complex.reserved.value As 'Reserved' Where SourceComps('NETADDR') In ($host) And df_complex.used.value Exists Sort By MetricTime Desc Range 1,20",
          "datasource": {
            "type": "meshiq-platform-datasource",
            "uid": "meshiq-platform"
          }
        }
      ],
      "options": {
        "showHeader": true,
        "sortBy": []
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "align": "auto",
            "displayMode": "color-background",
            "cellOptions": {
              "type": "color-background"
            }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Mount"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "custom.displayMode",
                "value": "auto"
              }
            ]
          }
        ]
