      "targets": [
        {
          "refId": "A",
          "format": "timeseries",
          "jkql": "Get COLLECTD.LOAD Field MetricTime, load.shortterm As 'Load (1m)', load.midterm As 'Load (5m)', load.longterm As 'Load (15m)' Where SourceComps('NETADDR') In ($host) Sort By MetricTime",
          "datasource": {
            "type": "meshiq-platform-datasource",
            "uid": "meshiq-platform"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
