          "jkql": "Get COLLECTD.MEMORY Field MetricTime, memory.used.value As 'Used', memory.free.value As 'Free', memory.cached.value As 'Cached' Where SourceComps('NETADDR') In ($host) Sort By MetricTime",
          "datasource": {
            "type": "meshiq-platform-datasource",
            "uid": "meshiq-platform"
