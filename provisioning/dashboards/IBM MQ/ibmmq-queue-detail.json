    {
      "id": 7,
      "type": "table",
      "title": "Last activity",
      "datasource": {
        "type": "meshiq-platform-datasource",
        "uid": "meshiq-platform"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 6,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "jkql": "Get IbmmqLocalQueue Fields lastPutDate As 'Last Put Date', lastPutTime As 'Last Put Time', lastGetDate As 'Last Get Date', lastGetTime As 'Last Get Time', timeSinceReset As 'Since Reset' Where WgsQueueManagerName = '$qmgr' And Name = '$queue'",
          "datasource": {
            "type": "meshiq-platform-datasource",
            "uid": "meshiq-platform"
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "custom": {
            "cellOptions": {
              "type": "color-text"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Since Reset"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          }
        ]
      }
    },
    {
      "id": 8,
      "type": "table",
      "title": "Configuration",
      "datasource": {
        "type": "meshiq-platform-datasource",
        "uid": "meshiq-platform"
      },
      "gridPos": {
        "h": 7,
        "w": 10,
        "x": 14,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "jkql": "Get IbmmqLocalQueue Fields usage As 'Usage', defPersistence As 'Default Persistence', inhibitGet As 'Get Inhibited', inhibitPut As 'Put Inhibited', maxMsgLength As 'Max Message Length', depthHighLimit As 'Depth High Limit', triggerType As 'Trigger Type', backoutThreshold As 'Backout Threshold', backoutReQName As 'Backout Requeue Queue' Where WgsQueueManagerName = '$qmgr' And Name = '$queue'",
          "datasource": {
            "type": "meshiq-platform-datasource",
            "uid": "meshiq-platform"
          }
        }
      ],
      "options": {
