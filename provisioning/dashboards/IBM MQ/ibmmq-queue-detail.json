      "targets": [
        {
          "refId": "A",
          "format": "table",
          "jkql": "Get IbmmqLocalQueue Fields openInputCount As 'Input', openOutputCount As 'Output' Where WgsQueueManagerName = '$qmgr' And Name = '$queue'",
          "datasource": {
            "type": "meshiq-platform-datasource",
