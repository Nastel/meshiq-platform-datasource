            "cellOptions": {
              "type": "color-text"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Max Message Length"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          }
