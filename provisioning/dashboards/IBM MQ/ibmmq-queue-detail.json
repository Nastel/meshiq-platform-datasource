    {
      "id": 101,
      "type": "row",
      "title": "Other queues with messages on $qmgr",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 15
      },
      "panels": []
    },
    {
      "id": 9,
      "type": "table",
      "title": "Queues with messages",
      "description": "Click a row to switch this dashboard to that queue.",
      "datasource": {
        "type": "meshiq-platform-datasource",
        "uid": "meshiq-platform"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "jkql": "Get IbmmqLocalQueue Fields Name As 'Queue', curQDepth As 'Current Depth', maxDepth As 'Max Depth', openInputCount As 'Open Input', openOutputCount As 'Open Output', oldestMsgAge As 'Oldest Message Age', uncommittedMsgs As 'Uncommitted' Where WgsQueueManagerName = '$qmgr' And curQDepth > 0 Sort By 'Current Depth' Desc",
          "datasource": {
            "type": "meshiq-platform-datasource",
            "uid": "meshiq-platform"
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {
          "links": [
            {
              "title": "Show this queue",
              "url": "/d/meshiq-ibmmq-queue?var-qmgr=${qmgr}&var-queue=${__data.fields[0]}"
            }
          ],
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "custom": {
            "cellOptions": {
              "type": "color-text"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Oldest Message Age"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          }
        ]
      }
