{
  "uid": "meshiq-ibmmq-queue",
  "title": "IBM MQ — Queue Detail",
  "description": "Detailed live state of one IBM MQ local queue. Opened from the IBM MQ — Live State overview (deepest queues / queues near capacity), or standalone via the queue-manager and queue variables.",
  "tags": [
    "showcase",
    "meshiq",
    "ibm-mq"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 0,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "schemaVersion": 39,
  "templating": {
    "list": [
      {
        "name": "qmgr",
        "label": "Queue manager",
        "type": "query",
        "datasource": {
          "type": "meshiq-platform-datasource",
          "uid": "meshiq-platform"
        },
        "query": {
          "type": "query",
          "jkql": "Get IbmmqQueueManager Fields Name Where nodeType = 'Connection Manager' Sort By Name",
          "refId": "variable-qmgr"
        },
        "multi": false,
        "includeAll": false,
        "refresh": 1,
        "sort": 0,
        "current": {},
        "options": []
      },
      {
        "name": "queue",
        "label": "Queue",
        "type": "query",
        "datasource": {
          "type": "meshiq-platform-datasource",
          "uid": "meshiq-platform"
        },
        "query": {
          "type": "query",
          "jkql": "Get IbmmqLocalQueue Fields Name Where WgsQueueManagerName = '$qmgr' Sort By Name",
          "refId": "variable-queue"
        },
        "multi": false,
        "includeAll": false,
        "refresh": 1,
        "sort": 0,
        "current": {},
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "Queue $queue on $qmgr",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 1,
      "type": "gauge",
      "title": "Depth used",
      "datasource": {
        "type": "meshiq-platform-datasource",
        "uid": "meshiq-platform"
      },
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "jkql": "Get IbmmqLocalQueue Fields curQDepth * 100 / maxDepth As 'Depth Used' Where WgsQueueManagerName = '$qmgr' And Name = '$queue'",
          "datasource": {
            "type": "meshiq-platform-datasource",
            "uid": "meshiq-platform"
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 70
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Depth (current / max)",
      "datasource": {
        "type": "meshiq-platform-datasource",
        "uid": "meshiq-platform"
      },
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "jkql": "Get IbmmqLocalQueue Fields curQDepth As 'Current', maxDepth As 'Max' Where WgsQueueManagerName = '$qmgr' And Name = '$queue'",
          "datasource": {
            "type": "meshiq-platform-datasource",
            "uid": "meshiq-platform"
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "orientation": "horizontal"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
