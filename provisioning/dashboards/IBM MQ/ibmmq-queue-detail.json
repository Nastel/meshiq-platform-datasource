        "uid": "meshiq-platform"
      },
      "gridPos": {
        "h": 7,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "jkql": "Get IbmmqLocalQueue Fields uncommittedMsgs As 'Uncommitted' Where WgsQueueManagerName = '$qmgr' And Name = '$queue'",
          "datasource": {
            "type": "meshiq-platform-datasource",
            "uid": "meshiq-platform"
          }
