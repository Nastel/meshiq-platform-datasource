# Copy to `.env` and fill in real values. `.env` is gitignored — never commit secrets.
# docker-compose.yaml reads these and injects them into the Grafana dev container, where
# the provisioned "meshIQ Platform" datasource picks them up (provisioning/datasources).

# Base URL of the meshIQ dataservice — scheme + host + port, plus any base path your
# deployment uses, e.g. https://your-dataservice-host:8080/ds-api
MESHIQ_SERVICE_URL=https://your-dataservice-host:8080/ds-api

# API access token for the dataservice.
MESHIQ_ACCESS_TOKEN=your-access-token

# Optional: turn on jKQL autocomplete and set the base URL of the completion service.
# Leave both unset/blank to keep completion disabled.
MESHIQ_ENABLE_COMPLETION=false
MESHIQ_COMPLETION_SERVICE_URL=

# Optional: Grafana version for the dev container (default: see .config/docker-compose-base.yaml).
# Set to the oldest supported version (grafanaDependency in src/plugin.json) so day-to-day dev
# testing catches minimum-version issues. Override to test against a newer Grafana.
GRAFANA_VERSION=12.3.0
